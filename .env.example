# Copy to .env next to compose.yml. Only the api container reads it.

# Where users open Echo, scheme and host only. Sign-in returns to <ECHO_PUBLIC_URL>/api/auth/callback,
# and requests that change data must come from this origin. For development with Vite (npm run dev
# in web/), set http://localhost:5173 and add its /api/auth/callback as a redirect URI in Entra.
ECHO_PUBLIC_URL=http://localhost:8000

# The Entra app registration for your organization (single tenant). Only users of this tenant can sign in.
ECHO_MS_TENANT_ID=
ECHO_MS_CLIENT_ID=
ECHO_MS_CLIENT_SECRET=

# Encrypts stored provider keys. Make one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Changing it makes every stored key unreadable.
ECHO_SECRET_KEY=

# Where the agents' dev servers are previewed, scheme and domain only. Each agent and port gets its
# own subdomain, so the domain must not be Echo's own; browsers send any *.localhost name to this
# machine, so this works locally with no setup. In production use https with a wildcard DNS name and
# certificate, ideally on a separate domain. Unset turns previews off.
# ECHO_PREVIEW_URL=http://preview.localhost:8000

# Host port for the api on 127.0.0.1. Read by compose, not the api.
# ECHO_PORT=8000

# Optional limits, in seconds.
# ECHO_COMMAND_TIMEOUT=120
# Keep equal to the sandbox's RUNNER_TIMEOUT_MAX.
# ECHO_COMMAND_TIMEOUT_MAX=1800
# ECHO_TURN_TIMEOUT=1800

# Optional quotas. Disk per agent (its files and home, in MB; read by compose for the sandbox),
# agents per user, and turns one user may run at once.
# ECHO_AGENT_DISK_MB=2048
# ECHO_MAX_AGENTS=50
# ECHO_MAX_RUNNING_TURNS=2
