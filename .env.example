# Copy to .env next to compose.yml. Only the api container reads it.

# The models users can pick from, comma separated provider/model strings. The first is the default.
# Any LiteLLM model works as litellm/<model>.
ECHO_MODELS=anthropic/claude-sonnet-5-5

# Keys for the providers named in ECHO_MODELS. The api must restart to pick up a change.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Host port for the api on 127.0.0.1. Read by compose, not the api.
# ECHO_PORT=8000

# Optional limits, in seconds.
# ECHO_COMMAND_TIMEOUT=120
# ECHO_TURN_TIMEOUT=1800
