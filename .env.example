# Copy to .env next to compose.yml. Only the api container reads it.

# Where users open Echo, scheme and host only. Sign-in returns to <ECHO_PUBLIC_URL>/api/auth/callback,
# and requests that change data must come from this origin.
ECHO_PUBLIC_URL=http://localhost:8000

# The Entra app registration for your organization (single tenant). Only users of this tenant can sign in.
ECHO_MS_TENANT_ID=
ECHO_MS_CLIENT_ID=
ECHO_MS_CLIENT_SECRET=

# Encrypts stored provider keys. Make one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Changing it makes every stored key unreadable.
ECHO_SECRET_KEY=

# Host port for the api on 127.0.0.1. Read by compose, not the api.
# ECHO_PORT=8000

# Optional limits, in seconds.
# ECHO_COMMAND_TIMEOUT=120
# ECHO_TURN_TIMEOUT=1800
